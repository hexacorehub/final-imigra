# Nada aqui é obrigatório hoje: sem estas variáveis o app roda 100% estático,
# com a base de conhecimento de src/lib/kb/data/kb.json e os dados do usuário só no aparelho.

# --- Base de conhecimento ---
# "static" (padrão) usa kb.json. "supabase" lê as tabelas kb_* no momento do build
# (as páginas continuam estáticas; um deploy hook do Vercel atualiza o site quando a base mudar).
KB_SOURCE=static
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Sincronização do usuário entre aparelhos (futuro login) ---
# Quando definidas no build, o navegador pode falar com o Supabase (a CSP é liberada só para essa URL).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
